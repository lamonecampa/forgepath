{
  "name": "forgepath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:php": "vite build --config vite.php.config.js",
    "copy:clang": "clang-wasm-copy-assets assets/clang",
    "build:clang": "npm run copy:clang && vite build --config vite.clang.config.js",
    "build:csharp": "vite build --config vite.csharp.config.js"
  },
  "dependencies": {
    "@php-wasm/universal": "3.1.60",
    "@php-wasm/web": "3.1.60",
    "@live-codes/clang-wasm": "0.3.0",
    "@wasmsharp/core": "0.10.2"
  },
  "devDependencies": {
    "vite": "7.3.1",
    "vite-plugin-ignore-dynamic-imports": "1.0.2"
  }
}
